{
  "name": "me-viaggi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "M&E Viaggi — archivio condiviso dei viaggi con itinerario, documenti e riepilogo.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node --disable-warning=ExperimentalWarning --import tsx server/node/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test --test-reporter=spec tests/*.test.ts",
    "test:e2e": "tsx tests/e2e/smoke.ts",
    "cf:dev": "npm run build && wrangler dev",
    "cf:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf:migrate": "wrangler d1 migrations apply DB --remote",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "lucide-react": "0.468.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "4.22.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "playwright-core": "1.56.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
