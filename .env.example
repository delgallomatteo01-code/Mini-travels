# Copia questo file in .env (server Node) oppure .dev.vars (wrangler dev) e scegli i valori.
# Nessun valore qui è un segreto reale: sono solo esempi.

# Password condivisa da Matteo ed Elena per entrare e modificare (minimo 6 caratteri).
APP_PASSWORD=cambia-questa-password

# Chiave per firmare i cookie di sessione (stringa lunga e casuale).
# Facoltativa: se manca viene derivata da APP_PASSWORD (cambiare la password scollega tutti).
AUTH_SECRET=

# Solo per sviluppo locale: "true" disattiva il login. MAI in produzione.
AUTH_DISABLED=false

# Server Node: cartella dati (database SQLite + file caricati) e porta.
DATA_DIR=.data
PORT=8787
